---
import Levels from '../components/Levels.astro'
import Course from '../layouts/Course.astro'
import { auditMap } from '../lib/audit'
import { glyphSvg, qSvg } from '../lib/glyphs'
import { nojsSvg } from '../lib/nojs'
import { getCourse, getWorld, json } from '../lib/pages'
import { esc } from '../lib/render-card'
import { url } from '../lib/base'

const course = await getCourse()
const w = await getWorld()
const { cours, cards } = course
// The map: its lattice and its placement rules, audited at the reference panes. A fault fails the
// build, as a fault in a card does.
const map = auditMap(course, w)
if (map.faults.length) {
  const message = `The map is not clean:\n${map.faults.join('\n')}`
  if (import.meta.env.DEV) console.error(message)
  else throw new Error(message)
}
const byId = new Map(w.levels.map((l) => [l.id, l]))
const chapters = cards.filter((c) => c.chapitre).sort((a, b) => a.chapitre! - b.chapitre!)
const quest = w.regions.find((r) => chapters.some((c) => c.quartier === r.id))
// The head's counter: every level on the map (the course's own total).
const onMap = w.order.filter((id) => map.tree.data.axes.h.tiles.some((t) => t.id === id)).map((id) => byId.get(id)!)
const first = chapters[0]!

// The chapters, in order, in the slot the home's text leaves for them.
const list = chapters
  .map((c) => {
    const inner = `<span class="num">${c.chapitre}</span><span><b>${esc(c.titre)}</b><small>${c.resume}</small></span>`
    return `<li>${c.prevu ? `<span class="t prevu">${inner}</span>` : `<a href="${url(`${c.id}/`)}">${inner}</a>`}</li>`
  })
  .join('')
const home = course.home.replace(/<ol\b[^>]*\bid="chapitres"[^>]*>/, (open) => open + list)
---

<Course title={cours.titre} description={cours.sousTitre} path="/" home>
  <div class="app" id="app">
    <header class="head">
      <a class="brand" href={url()} aria-label={cours.titre}>
        <Fragment set:html={qSvg(3)} />
        <span class="t">{cours.titre}</span>
        <span class="ts">{cours.court}</span>
      </a>
      <div class="counts">
        <span class="count" aria-label="compris"><Fragment set:html={glyphSvg('check', 2)} /><b class="num" id="n-lus">0/{onMap.length}</b></span>
        <span class="count" aria-label={quest?.nom}><Fragment set:html={glyphSvg('chapters', 2)} /><b class="num" id="n-chap">0/{chapters.length}</b></span>
      </div>
      <a class="btn primary" id="go" href={first.prevu ? '#plan' : url(`${first.id}/`)}><span>Commencer ici</span><Fragment set:html={glyphSvg('next', 2)} /></a>
      <a class="key" id="cherche" href="#plan" aria-label="Chercher dans le cours" aria-controls="plan" aria-expanded="false"><Fragment set:html={glyphSvg('search', 2)} /></a>
    </header>
    <main class="pane" id="pane">
      <noscript><div class="nojs-map" set:html={nojsSvg(map.tree.data, w)} /></noscript>
      <canvas id="map" aria-hidden="true"></canvas>
      <div class="links" id="links"></div>
      <div class="zbar" id="zbar">
        <button class="key back" id="carte-k" type="button"><Fragment set:html={glyphSvg('back', 2)} /><span>Carte</span></button>
        <span class="zb-reg"><i class="zb-tick"></i><span class="eyebrow" id="zb-n"></span><span class="num" id="zb-c"></span><span class="zb-s" id="zb-s" aria-hidden="true"></span></span>
        <span class="zb-toast" id="zb-toast" aria-hidden="true"></span>
      </div>
      <div class="band" id="band" aria-hidden="true"></div>
      <div class="tip" id="tip" aria-hidden="true"></div>
      <p class="sr" id="live" aria-live="polite"></p>
    </main>
    <aside class="brief" id="brief">
      <div class="mini" id="mini" aria-hidden="true"><canvas></canvas></div>
      <div class="peek" id="peek"></div>
      <div class="bc" id="bc" aria-live="polite"></div>
    </aside>
    <nav class:list={['track', quest && `h${quest.hue}`]} id="track" aria-label={quest?.nom}>
      <span class="eyebrow">{quest?.nom}</span>
      <ol>
        {
          chapters.map((c) => {
            const l = byId.get(c.id)!
            return (
              <li class:list={['seg', `h${l.hue}`, { prevu: l.prevu }]} data-ch={c.id}>
                <a href={l.prevu ? `#lv-${c.id}` : url(`${c.id}/`)} aria-label={c.titre}>
                  <Fragment set:html={qSvg(2)} />
                  <span class="num">{l.label}</span>
                  <span class="seg-b"><span class="seg-f"></span></span>
                </a>
              </li>
            )
          })
        }
      </ol>
      <p class="cap" id="cap" aria-hidden="true"></p>
    </nav>
  </div>
  <section class="home" id="plan" aria-labelledby="plan-h">
    <div class="home-in">
      <header class="home-h">
        <h2 id="plan-h">Plan du cours</h2>
        <button class="key" id="plan-x" type="button" aria-label="Fermer"><Fragment set:html={glyphSvg('close', 2)} /></button>
      </header>
      <div class="accueil" set:html={home} />
      <Levels inline />
    </div>
  </section>
  <script is:inline type="application/json" id="arbre" set:html={json(map.tree.data)} />
</Course>
