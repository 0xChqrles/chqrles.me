---
import Levels from '../components/Levels.astro'
import { getCourse, getWorld, json } from '../lib/pages'
import '@chqrles/design/fonts.css'
import '@fontsource-variable/instrument-sans/wdth.css'
import '@fontsource-variable/jetbrains-mono/wght.css'
import '@fontsource-variable/jetbrains-mono/wght-italic.css'
import 'katex/dist/katex.min.css'
import '../styles/course.css'
import { url } from '../lib/base'

interface Props {
  title: string
  description: string
  // Absent on the 404 page, which has no canonical URL.
  path?: string
  // The home page holds the level list in its flow.
  home?: boolean
  // The page's 1200 × 630 share image (under the course's path) and its alt text.
  share?: { path: string; alt: string }
  // A card's page is an article; the home and the list of cards are the course itself.
  article?: boolean
}

const { title, description, path, home, share, article } = Astro.props
const w = await getWorld()
const { cours } = await getCourse()
const canonical = path && new URL(url(path), Astro.site).href
const shareUrl = share && new URL(url(share.path), Astro.site).href
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={cours.titre} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content={shareUrl ? 'summary_large_image' : 'summary'} />
    {
      shareUrl && share && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:type" content="image/png" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={share.alt} />
          <meta name="twitter:image" content={shareUrl} />
          <meta name="twitter:image:alt" content={share.alt} />
        </>
      )
    }
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="stylesheet" href={url('math.css')} />
    <link rel="stylesheet" href={url('palette.css')} />
    <script is:inline src={url('boot.js')}></script>
  </head>
  <body class:list={[home ? 'is-home' : 'is-page']}>
    <slot />
    {!home && <Levels />}
    <div id="pop" hidden></div>
    <svg class="defs" width="0" height="0" aria-hidden="true">
      <defs>
        <marker id="fa" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" class="fig-a"></path></marker>
        <marker id="fam" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" class="fig-am"></path></marker>
        <marker id="fac" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0L8 4L0 8z" class="fig-ac"></path></marker>
      </defs>
    </svg>
    <script is:inline type="application/json" id="monde" set:html={json(w)} />
    <script>
      import '../scripts/course'
    </script>
  </body>
</html>
