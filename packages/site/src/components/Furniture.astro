---
// The viewport as an instrument. Drawn at the edges of a wide screen, never in
// the way: hidden on a phone, hidden from assistive tech, deaf to the pointer.
// The playhead and timeline come alive only when the script runs.
---

<div class="playhead" aria-hidden="true"></div>
<div class="furniture" aria-hidden="true">
  <div class="timeline"><div class="fill"></div><div class="head micro"><span class="time"></span></div></div>
  <div class="strip"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
</div>
