---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

// The header image as a record sleeve: a square, printed in one ink on the
// black card (its shadows are the ground, its lights the ink) and trimmed by
// printer's crop marks. Both are CSS: the photograph itself is untouched.
interface Props {
  src: ImageMetadata
  alt: string
}

const { src, alt } = Astro.props
// A square crop, as large as the image allows (never enlarged), centred on
// what sharp finds most salient rather than on the middle of the frame.
const side = Math.min(src.width, src.height, 1440)
const widths = [480, 720, 960, 1200, 1440].filter((w) => w <= side)
---

<figure class="sleeve crop">
  <Picture
    src={src}
    alt={alt}
    width={side}
    height={side}
    fit="cover"
    position="attention"
    formats={['avif', 'webp']}
    widths={widths}
    sizes="(min-width: 641px) 420px, calc(100vw - 32px)"
    priority
  />
</figure>
