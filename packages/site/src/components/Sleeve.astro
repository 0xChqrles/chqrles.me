---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'
import { sleeveRatio } from '../lib/sleeve'

// The header image as a record sleeve: the photo in its own shape, trimmed by
// printer's crop marks, printed in one ink on the black card (its shadows the
// ground, its lights the ink). Its share image prints it as a one-bit dither
// (src/lib/share-card.ts); here it stays a photo, legible at any size.
interface Props {
  src: ImageMetadata
  alt: string
}

const { src, alt } = Astro.props
// As large as the image allows, never enlarged.
const ratio = sleeveRatio(src.width, src.height)
const width = Math.round(Math.min(src.width, src.height * ratio, 1440))
const height = Math.round(width / ratio)
const widths = [480, 720, 960, 1200, 1440].filter((w) => w <= width)
// The width it is drawn at: the column's, or less where the screen's height
// caps it (src/styles/site.css).
const sizes = `min(100vw - 32px, 660px, 60svh * ${ratio.toFixed(3)})`
---

<figure class="sleeve crop">
  {/* The trim: an empty SVG in the sleeve's shape, at its largest size, holds
      that shape before the photo loads, scaled down whole to fit
      (src/styles/site.css). */}
  <svg class="trim" width={width} height={height} viewBox={`0 0 ${width} ${height}`} aria-hidden="true"></svg>
  <Picture
    src={src}
    alt={alt}
    width={width}
    height={height}
    fit="cover"
    position="attention"
    formats={['avif', 'webp']}
    widths={widths}
    sizes={sizes}
    priority
  />
</figure>
