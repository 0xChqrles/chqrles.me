---
import type { ImageMetadata } from 'astro'
import { Picture } from 'astro:assets'

// The header image as a record sleeve: a square, trimmed by printer's crop
// marks. The script prints it again as a one-ink dot screen on the canvas;
// without the script it stays a photograph, in one ink.
interface Props {
  src: ImageMetadata
  alt: string
}

const { src, alt } = Astro.props
// A square crop, as large as the image allows (never enlarged), centred on
// what sharp finds most salient rather than on the middle of the frame.
const side = Math.min(src.width, src.height, 1440)
const widths = [480, 720, 960, 1200, 1440].filter((w) => w <= side)
---

<figure class="sleeve crop">
  <Picture
    src={src}
    alt={alt}
    width={side}
    height={side}
    fit="cover"
    position="attention"
    formats={['avif', 'webp']}
    widths={widths}
    sizes="(min-width: 1040px) 420px, min(600px, calc(100vw - 32px))"
    priority
  />
  <canvas aria-hidden="true"></canvas>
</figure>
