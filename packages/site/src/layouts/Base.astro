---
import Furniture from '../components/Furniture.astro'
import Mark from '../components/Mark.astro'
import type { Lang } from '../lib/posts'
import { SITE_NAME } from '../site'
import '../styles/fonts.css'
import '../styles/site.css'

interface Props {
  title: string
  description: string
  lang: Lang
  // Absent on the 404 page, which has no canonical URL.
  path?: string
  article?: { published: Date }
  // The 1200×630 share image and its alt text.
  share?: { src: string; alt: string }
  // The index: the mark is where you already are, so it is not a link.
  home?: boolean
}

const { title, description, lang, path, article, share, home = false } = Astro.props
const canonical = path && new URL(path, Astro.site).href
const shareUrl = share && new URL(share.src, Astro.site).href
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content={shareUrl ? 'summary_large_image' : 'summary'} />
    {
      shareUrl && share && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={share.alt} />
          <meta name="twitter:image" content={shareUrl} />
          <meta name="twitter:image:alt" content={share.alt} />
        </>
      )
    }
  </head>
  <body>
    <header class="masthead">
      {
        home ? (
          <Mark />
        ) : (
          <a href="/" aria-label={SITE_NAME}>
            <Mark />
          </a>
        )
      }
    </header>
    <slot />
    <Furniture />
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
