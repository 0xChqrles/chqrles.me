---
import Furniture from '../components/Furniture.astro'
import Mark from '../components/Mark.astro'
import { LANGUAGES, type Lang } from '../lib/lang'
import { languagePath } from '../lib/urls'
import { SITE_NAME, UMAMI_WEBSITE_ID } from '../site'
import '../styles/fonts.css'
import '../styles/site.css'

interface Props {
  title: string
  description: string
  lang: Lang
  // Absent on the 404 page, which has no canonical URL (and is in no language).
  path?: string
  // The same page in each language it comes in, this one included.
  alternates?: { lang: Lang; path: string }[]
  article?: { published: Date }
  // The 1200×630 share image and its alt text.
  share?: { src: string; alt: string }
  // The index: the mark is where you already are, so it is not a link.
  home?: boolean
}

const { title, description, lang, path, alternates = [], article, share, home = false } = Astro.props
const canonical = path && new URL(path, Astro.site).href
const shareUrl = share && new URL(share.src, Astro.site).href
const others = alternates.filter((alternate) => alternate.lang !== lang)
// The mark leads home in the reader's language; the 404 page has none.
const homePath = path ? languagePath(lang) : '/'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {others.length > 0 && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.lang} href={new URL(alternate.path, Astro.site).href} />)}
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={`/${lang}/rss.xml`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={LANGUAGES[lang].locale} />
    {others.map((alternate) => <meta property="og:locale:alternate" content={LANGUAGES[alternate.lang].locale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content={shareUrl ? 'summary_large_image' : 'summary'} />
    {
      shareUrl && share && (
        <>
          <meta property="og:image" content={shareUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={share.alt} />
          <meta name="twitter:image" content={shareUrl} />
          <meta name="twitter:image:alt" content={share.alt} />
        </>
      )
    }
    {/* Umami counts the page views on the live site only: dev and preview send nothing. */}
    <script is:inline defer src="https://cloud.umami.is/script.js" data-website-id={UMAMI_WEBSITE_ID} data-domains={Astro.site!.hostname}></script>
  </head>
  <body>
    <header class="masthead">
      {
        home ? (
          <Mark />
        ) : (
          <a href={homePath} aria-label={SITE_NAME}>
            <Mark />
          </a>
        )
      }
      <slot name="masthead" />
    </header>
    <slot />
    <Furniture />
    <script>
      import '../scripts/site'
    </script>
  </body>
</html>
