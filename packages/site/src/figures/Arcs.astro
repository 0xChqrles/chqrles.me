---
import Figure from './Figure.astro'
import { formatPercent } from './format'

// A sequence of tokens, and weighted arcs from one of them to others: what a
// word attends to, what it borrows from. Optionally, the tokens it cannot see
// (a causal mask: everything after it) and the weighted sum it ends up with.
// Plain HTML and SVG: nothing runs in the browser.
interface Target {
  token: number
  // 0 to 1: sets the arc's weight and is written under the token.
  weight?: number
  // The one arc the caption is about, in the accent.
  accent?: boolean
}

interface Props {
  tokens: string[]
  from: number
  to: Target[]
  mask?: 'causal'
  sum?: boolean
  caption: string
}

const { tokens, from, to, mask, sum, caption } = Astro.props
const lang = Astro.locals.lang ?? 'fr'
const weights = new Map(to.map(({ token, weight }) => [token, weight]))
const accented = new Set(to.filter(({ accent }) => accent).map(({ token }) => token))
const total = to.reduce((s, { weight }) => s + (weight ?? 0), 0)

// Each token owns a slot 100 units wide; an arc rises higher the farther it
// goes, the longest possible one to the top. A token attending to itself gets
// a small loop that leaves and lands on it.
const arc = (target: number) => {
  const a = from * 100 + 50
  const b = target * 100 + 50
  if (target === from) return `M${a - 12} 100 C${a - 40} 45 ${a + 40} 45 ${a + 12} 100`
  const top = 88 - 80 * (Math.abs(from - target) / Math.max(1, tokens.length - 1))
  return `M${a} 100 C${a} ${top} ${b} ${top} ${b} 100`
}

// The weighted sum: one segment per target, as wide as its weight, in reading order.
let start = 0
const segments = [...to]
  .sort((p, q) => p.token - q.token)
  .map(({ token, weight = 0 }) => {
    const segment = { token, weight, x: (start / total) * 100, width: (weight / total) * 100 }
    start += weight
    return segment
  })
---

<Figure caption={caption}>
  <div class="arcs">
    <svg class="arcs-lines" viewBox={`0 0 ${tokens.length * 100} 100`} preserveAspectRatio="none" aria-hidden="true">
      {
        to.map(({ token, weight, accent }) => (
          <path class:list={{ 'is-accent': accent }} d={arc(token)} stroke-width={weight === undefined ? 1.5 : 1 + 3 * weight} vector-effect="non-scaling-stroke" />
        ))
      }
    </svg>
    <ol class="arcs-tokens">
      {
        tokens.map((word, i) => (
          <li class:list={['token', { 'is-from': i === from, 'is-to': weights.has(i), 'is-accent': accented.has(i), 'is-hidden': mask === 'causal' && i > from }]}>
            <span class="token-word">{word}</span>
            {weights.get(i) !== undefined && <span class="token-weight">{formatPercent(weights.get(i)! * 100, lang)}</span>}
          </li>
        ))
      }
    </ol>
    {
      sum && (
        <svg class="arcs-sum" width="100%" height="40" aria-hidden="true">
          {segments.map(({ token, weight, x, width }) => (
            <>
              <rect class:list={['sum-part', { 'is-major': weight === Math.max(...segments.map((s) => s.weight)) }]} x={`${x}%`} width={`${width}%`} y="0" height="10" />
              <text class:list={{ 'is-accent': accented.has(token) }} x={`${x + width / 2}%`} y="30" text-anchor="middle">
                {tokens[token]}
              </text>
            </>
          ))}
        </svg>
      )
    }
  </div>
</Figure>
