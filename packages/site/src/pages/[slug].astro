---
import { render } from 'astro:content'
import Mark from '../components/Mark.astro'
import Sleeve from '../components/Sleeve.astro'
import { figures } from '../figures'
import Base from '../layouts/Base.astro'
import { formatDuration, trackNumber } from '../lib/duration'
import { formatDate, getTracks, typeset, type Track } from '../lib/posts'
import { assertShareable } from '../lib/share-image'
import { postPath } from '../lib/urls'
import { SITE_NAME } from '../site'

export async function getStaticPaths() {
  const tracks = await getTracks()
  return tracks.map((track) => ({ params: { slug: track.post.id }, props: { track } }))
}

interface Props {
  track: Track
}

const { post, number, seconds } = Astro.props.track
const { title, description, date, image, imageAlt, lang } = post.data
const { Content } = await render(post)
// The post's figures write numbers in its language.
Astro.locals.lang = lang
if (image) assertShareable(post.id, image)
// The link preview is the post's share card (src/pages/[slug]/share.png.ts).
const share = image && imageAlt ? { src: `${postPath(post.id)}share.png`, alt: imageAlt } : undefined
const day = date.toISOString().slice(0, 10)
---

<Base
  title={typeset(title, lang)}
  description={typeset(description, lang)}
  lang={lang}
  path={postPath(post.id)}
  article={{ published: date }}
  share={share}
>
  <main class="record column">
    <article>
      {/* Only a draft may have no photo: its header then stays in the column. */}
      <header class:list={['sleeve-head', { 'has-sleeve': image && imageAlt }]}>
        <div class="title-row">
          <span class="track-no" aria-hidden="true">{trackNumber(number)}</span>
          <h1>{typeset(title, lang)}</h1>
        </div>
        {/* The sleeve's credits: the date, the length (the sum of the sections), the language. */}
        <ul class="credits micro">
          <li><time datetime={day}>{formatDate(date, lang)}</time></li>
          <li><span class="sum">{formatDuration(seconds)}</span></li>
          <li>{lang}</li>
        </ul>
        {image && imageAlt && <Sleeve src={image} alt={imageAlt} />}
      </header>
      <div class="prose" data-total={seconds}>
        <Content components={figures} />
      </div>
      {/* The run-out: the centre label, and the way back. */}
      <footer class="runout">
        <a href="/" aria-label={SITE_NAME}><Mark /></a>
      </footer>
    </article>
  </main>
</Base>
