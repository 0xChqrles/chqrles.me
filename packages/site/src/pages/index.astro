---
import Base from '../layouts/Base.astro'
import { formatDuration, trackNumber } from '../lib/duration'
import { formatDate, getTracks, typeset } from '../lib/posts'
import { postPath } from '../lib/urls'
import { SITE_DESCRIPTION, SITE_NAME } from '../site'

// The index is the sleeve's tracklist, newest first.
const tracks = await getTracks()
const total = tracks.reduce((sum, { seconds }) => sum + seconds, 0)
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION} lang="fr" path="/" home>
  <main class="tracklist column">
    <ol class="tracks">
      {
        tracks.map(({ post: { id, data }, number, seconds }) => (
          <li class="track" lang={data.lang === 'fr' ? undefined : data.lang}>
            <a class="track-row" href={postPath(id)}>
              <span class="track-no">{trackNumber(number)}</span>
              <span class="track-title">{typeset(data.title, data.lang)}</span>
              <span class="track-meta micro">
                <time datetime={data.date.toISOString().slice(0, 10)}>{formatDate(data.date, data.lang)}</time>
                <span class="leader" aria-hidden="true" />
                <span class="track-len">{formatDuration(seconds)}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    {
      tracks.length > 1 && (
        <p class="total micro">
          <span class="sum">{formatDuration(total)}</span>
        </p>
      )
    }
  </main>
</Base>
