---
import { DEFAULT_LANG } from '../lib/lang'
import { languagePath } from '../lib/urls'

// On the live site the edge answers / itself, with the reader's language
// (packages/infra/functions/directory-urls.js). This is the way in under
// `pnpm dev` and `pnpm preview`, which have no edge.
return Astro.redirect(languagePath(DEFAULT_LANG), 307)
